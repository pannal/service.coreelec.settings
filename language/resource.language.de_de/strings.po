msgctxt "#600"
msgid "@DISTRONAME@ Settings"
msgstr "@DISTRONAME@-Einstellungen"

msgctxt "#601"
msgid "Interface"
msgstr "Schnittstelle"

msgctxt "#602"
msgid "Address"
msgstr "Adresse"

msgctxt "#603"
msgid "Type"
msgstr "Typ"

msgctxt "#604"
msgid "State"
msgstr "Status"

msgctxt "#605"
msgid "Address"
msgstr "Adresse"

msgctxt "#606"
msgid "Distribution: "
msgstr "Distribution: "

msgctxt "#607"
msgid "Version: "
msgstr "Version: "

msgctxt "#608"
msgid "Architecture: "
msgstr "Architektur: "

msgctxt "#609"
msgid "CoreELEC is created by a global team of Linux and Kodi enthusiasts who contribute time and effort to manage the project, write code, and provide support. We have fun making it. We hope you have fun using it!"
msgstr "CoreELEC wird von einem weltweiten Team aus Linux- und Kodi-Enthusiasten entwickelt, die Zeit und Mühe investieren, um das Projekt zu betreuen, Code zu schreiben und Support zu leisten. Wir haben Spaß daran, es zu entwickeln. Wir hoffen, es macht genauso viel Spaß, es zu benutzen!"

msgctxt "#610"
msgid "[B]Support[/B] is provided via our forum:[CR]https://discourse.coreelec.org[CR][CR][B]Documentation[/B] can be read at our website:[CR]https://coreelec.org[CR][CR][B]Wiki[/B] can be read at our website:[CR]https://wiki.coreelec.org[CR][CR][B]Code[/B] can be found on GitHub:[CR]https://github.com/CoreELEC[CR][CR]"
msgstr "[B]Support[/B] gibt es in unserem Forum:[CR]https://discourse.coreelec.org[CR][CR][B]Dokumentation[/B] ist auf unserer Website zu finden:[CR]https://coreelec.org[CR][CR][B]Wiki[/B] ist auf unserer Website zu finden:[CR]https://wiki.coreelec.org[CR][CR][B]Code[/B] ist auf GitHub zu finden:[CR]https://github.com/CoreELEC[CR][CR]"

msgctxt "#700"
msgid ""
"Configure a hostname, keyboard type, perform a reset, update, or backups and"
" restores"
msgstr "Konfiguriere einen Gerätenamen, einen Tastaturtypen, setze das System zurück, erstelle Datensicherungen oder stelle eine Datensicherung wieder her, übermittele einen Fehlerbericht."

msgctxt "#701"
msgid "Configure network startup options, NTP and VPNs"
msgstr "Netzwerkeinstellungen, Startoptionen, NTP und VPN konfigurieren."

msgctxt "#702"
msgid ""
"Manage the Ethernet, Wireless and VPN connections available to the system"
msgstr "Verfügbare LAN-, Drahtlos- und VPN-Verbindungen konfigurieren"

msgctxt "#703"
msgid "Configure system services like Samba, SSH, Cron, Avahi and Syslog"
msgstr "Systemdienste z.B. Samba Dateifreigaben, SSH Fernzugriffe, Cron, Avahi und Syslog konfigurieren"

msgctxt "#704"
msgid "Configure and pair Bluetooth devices"
msgstr "Bluetoothgeräte verbinden und verwalten"

msgctxt "#705"
msgid "Useful information like version and architecture details, support and documentation links."
msgstr "Nützliche Informationen wie Versions- und Architekturdetails sowie Support- und Dokumentations-Links."

msgctxt "#707"
msgid "Configure updates"
msgstr "Konfiguriere Aktualisierungen"

msgctxt "#710"
msgid ""
"Configure the Hostname of your @DISTRONAME@ system. This will be used for "
"the HTPC \\\\hostname in Windows and SMB server name in the Mac OS Finder"
msgstr "Konfigurieren Sie den Hostnamen Ihres @DISTRONAME@ Systems. Dies wird für den HTPC \\\\Hostnamen in Windows und für den SMB-Servernamen im Mac OS Finder verwendet werden."

msgctxt "#711"
msgid "Configure the 1st keyboard software layout"
msgstr "Primäres Tastaturschema"

msgctxt "#712"
msgid "Configure the 2nd keyboard software layout"
msgstr "Sekundäres Tastaturschema"

msgctxt "#713"
msgid "Configure the physical keyboard type"
msgstr "Tastaturbelegung konfigurieren"

msgctxt "#714"
msgid ""
"@DISTRONAME@ can be configured for automatic or manual updates. Automatic "
"updates are available on stable releases and stable release candidates. "
"Automatic update self-disables on beta and development builds"
msgstr "@DISTRONAME@ kann für automatische oder manuelle Aktualisierungen konfiguriert werden. Automatische Aktualisierungen sind für stabile Releases und Release Candidates für stabile Releases verfügbar. Automatische Aktualisierungen werden für Beta- und Entwickler- Versionen standardmäßig abgeschaltet."

msgctxt "#715"
msgid ""
"Set to ON and an on-screen notification will be displayed when a new update "
"is available"
msgstr "Auf EIN stellen und eine Bildschirm-Benachrichtigung wird angezeigt, sobald eine neue Aktualisierung verfügbar ist."

msgctxt "#716"
msgid "Update to the next stable release instead of remaining on nightly builds, when the next stable release is ready."
msgstr "Auf die nächste stabile Version aktualisieren, statt auf Nightly-Builds zu bleiben, sobald die nächste stabile Version verfügbar ist."

msgctxt "#718"
msgid ""
"Send boot config files from /flash, kodi.log, kernel log and Samba configs "
"to https://paste.coreelec.org, and display the short URL"
msgstr "Boot-Konfigurationen von /flash, kodi.log, kernel log und Samba-Konfigurationen an https://paste.coreelec.org übermitteln und die Kurz-URL anzeigen"

msgctxt "#719"
msgid ""
"Send boot config files from /flash, kodi_crash.log, kernel log and Samba "
"configs to https://paste.coreelec.org, and display the short URL"
msgstr "Boot-Konfigurationen von /flash, kodi_crash.log, kernel log und Samba-Konfigurationen an https://paste.coreelec.org übermitteln und die Kurz-URL anzeigen"

msgctxt "#720"
msgid "Set to ON to enable the Bluetooth service"
msgstr "Auf EIN stellen, um Bluetooth zu aktivieren"

msgctxt "#721"
msgid "Send CoreELEC debug info without logs to https://paste.coreelec.org, and display the short URL"
msgstr "CoreELEC-Debug-Informationen ohne Protokolle an https://paste.coreelec.org senden und die Kurz-URL anzeigen"

msgctxt "#722"
msgid ""
"Create a tar archive containing all @DISTRONAME@ and Kodi configuration "
"settings, databases and thumbnail content. Backup files will be stored in "
"/storage/backup/"
msgstr "Erzeugt ein Backup als tar-Archiv, welches die gesamten Einstellungen, Datenbanken und Vorschaubilder von @DISTRONAME@ und Kodi enthält. Die Sicherungen werden unter /storage/backup/ abgelegt."

msgctxt "#723"
msgid ""
"Restore a tar archive backup previously created using the backup option "
"above"
msgstr "Wiederherstellung einer Datensicherung, die hier mit der Sicherungsoption erstellt wurde"

msgctxt "#724"
msgid ""
"[COLOR FF00FF00]SOFT RESET[/COLOR]\n"
"Permanently reset @DISTRONAME@ configuration to defaults (resets also Kodi to default including your library. your media - music/videos/etc are not touched)"
msgstr "[COLOR FF00FF00]SOFT RESET[/COLOR]\nStandardeinstellungen von @DISTRONAME@ und Kodi dauerhaft wiederherstellen (inklusive Reset der Datenbank. Musik- und Video-Dateien etc. werden dabei aber nicht  verändert)."

msgctxt "#725"
msgid ""
"[COLOR FFFF0000]HARD RESET[/COLOR]\n"
"Permanently reset @DISTRONAME@ and Kodi configuration to defaults (everything in your storage partition will be deleted)"
msgstr "[COLOR FFFF0000]HARD RESET[/COLOR]\nStandardeinstellungen von @DISTRONAME@ und Kodi dauerhaft wiederherstellen (die gesamte Partition \"storage\" wird gelöscht)."

msgctxt "#726"
msgid "Enable or disable support for Wireless (WLAN) networks"
msgstr "Drahtlose Netzwerke (WLAN) aktivieren oder deaktivieren"

msgctxt "#727"
msgid ""
"Enable a 'tethered' Wireless Access Point. This requires your wireless card "
"(and driver) to support bridging and access point mode. Not all cards are "
"capable."
msgstr "Aktiviert die Freigabe Ihres Netzwerkes (Tethering). Hierfür ist ein Drahtlosnetzwerkadapter erforderlich, der als Zugriffspunkt arbeiten kann. Nicht alle Drahtlosnetzwerkadapter unterstützen diesen Modus."

msgctxt "#728"
msgid "Configure the Access Point SSID"
msgstr "Tethering Zugriffspunkt SSID (Name)"

msgctxt "#729"
msgid "Configure the Access Point Passphrase"
msgstr "Tethering Zugriffspunkt Passwort"

msgctxt "#730"
msgid "Enable or disable support for Wired (Ethernet) networks"
msgstr "Aktivieren bzw. deaktivieren von Kabelgebundenen Netzwerken (Ethernet)"

msgctxt "#732"
msgid "Configure the 1st time (NTP) server"
msgstr "Erster Zeitserver (NTP)"

msgctxt "#733"
msgid "Configure the 2nd time (NTP) server"
msgstr "Zweiter Zeitserver (NTP)"

msgctxt "#734"
msgid "Configure the 3rd time (NTP) server"
msgstr "Dritter Zeitserver (NTP)"

msgctxt "#736"
msgid ""
"Set to ON to delay Kodi startup until the network is available. Use this if "
"the OS is booting into Kodi before the network is up and central MySQL "
"databases are accessible."
msgstr "Auf EIN stellen, um den Start von Kodi zu verzögern, bis das Netzwerk verfügbar ist. Verwende dies, wenn das Betriebssystem Kodi startet, bevor das Netzwerk und MySQL-Datenbanken verfügbar sind."

msgctxt "#737"
msgid "Time in seconds to wait for an established network connection."
msgstr "Zeit in Sekunden, um auf eine bestehende Netzwerkverbindung zu warten."

msgctxt "#738"
msgid "Set to ON to enable the embedded Samba (SMB) filesharing service"
msgstr "Auf EIN stellen, um den eingebetteten Samba (SMB) Datenfreigabedienst zu aktivieren"

msgctxt "#739"
msgid ""
"Set to ON to require username/password access to local Samba fileshares"
msgstr "Auf EIN stellen, um beim Zugriff auf lokale Samba-Dateifreigaben einen Benutzernamen/ein Passwort zu benötigen"

msgctxt "#740"
msgid "Set the username for Samba sharing"
msgstr "Samba-Benutzername für Freigaben"

msgctxt "#741"
msgid "Set the password for Samba sharing"
msgstr "Samba-Passwort für Freigaben"

msgctxt "#742"
msgid ""
"Set to ON to enable the embedded SSH server. The SSH console can be accessed"
" with username 'root' and password '@ROOT_PASSWORD@'."
msgstr "Auf EIN stellen, um den eingebetteten SSH-Server zu aktivieren. Auf die SSH-Konsole kann mit dem Benutzernamen 'root' und dem Passwort '@ROOT_PASSWORD@' zugegriffen werden."

msgctxt "#743"
msgid ""
"Set to ON if you have copied private SSH keys to your HTPC and would like to"
" improve security by disabling SSH username and password authentication."
msgstr "Auf EIN stellen, wenn du private SSH-Schlüssel auf deinen HTPC kopiert haben und die Sicherheit durch Deaktivierung der SSH-Benutzernamen- und Passwort-Authentifizierung verbessern möchtest."

msgctxt "#744"
msgid ""
"Set to ON to enable the Avahi (Zeroconf/Bonjour) network discovery service"
msgstr "Auf EIN stellen, um den Avahi (Zeroconf/Bonjour) Netzwerkverzeichnisdienst zu aktivieren"

msgctxt "#745"
msgid "Set to ON to enable the cron daemon"
msgstr "Auf EIN stellen, um den Cron-Daemon zu aktivieren."

msgctxt "#746"
msgid "Set the password for SSH"
msgstr "Passwort für SSH setzen"

msgctxt "#747"
msgid "Enable a PIN for @DISTRONAME@ Settings access"
msgstr "PIN für den Zugriff auf die @DISTRONAME@ Einstellungen aktivieren"

msgctxt "#748"
msgid "Change the PIN Lock for @DISTRONAME@ Settings access"
msgstr "PIN für den Zugriff auf die @DISTRONAME@ Einstellungen ändern"

msgctxt "#749"
msgid ""
"Overrride the Wireless Regulatory Domain so radio properties (channels and "
"transmit power) comply with local laws or match the country configuration of"
" your router."
msgstr "Die Behördliche Bestimmungen (für Funkkanäle und Sendeleistung) überschreiben, um mit den örtlichen Gesetzen im Einklang zu stehen."

msgctxt "#750"
msgid "750"
msgstr "750"

msgctxt "#751"
msgid ""
"With OBEX filetransfer you can send files, for example movies or pictures "
"over bluetooth to @DISTRONAME@."
msgstr "Mit OBEX-Dateiübertragung kannst du Dateien, zum Beispiel Filme oder Bilder, über Bluetooth an @DISTRONAME@ senden."

msgctxt "#752"
msgid ""
"Here you can set the folder location where OBEX file transfer should store "
"incoming files"
msgstr "Hier kannst du den Speicherort auswählen, wo OBEX-Dateiübertragung die eingehenden Dateien abspeichert"

msgctxt "#753"
msgid "Configure the 1st keyboard software Variant"
msgstr "Konfiguration des 1. Tastaturschemas"

msgctxt "#754"
msgid "Configure the 2nd keyboard software Variant"
msgstr "Konfiguration des zweiten Tastaturschemas"

msgctxt "#755"
msgid "Auto share external drives / partitions"
msgstr "Automatische Freigabe externer Laufwerke / Partitionen"

msgctxt "#756"
msgid ""
"Disable older SMB protocols by specifying the minimum supported protocol."
msgstr "Zur Definition der niedrigsten unterstützten Protokoll-Version ältere SMB-Protokolle deaktivieren."

msgctxt "#757"
msgid ""
"Disable more recent SMB protocols for backward compatability with legacy "
"clients."
msgstr "Neuere SMB-Protokolle für die Abwärtskompatibilität mit veralteten Clients deaktivieren."

msgctxt "#758"
msgid "NetBIOS group to which the server belongs. Default is WORKGROUP."
msgstr "NetBIOS-Gruppe, zu der der Server gehört. Standard ist WORKGROUP."

msgctxt "#760"
msgid "Select an update channel"
msgstr "Update-Kanal auswählen"

msgctxt "#761"
msgid "Enable to allow entering a custom update url"
msgstr "Aktiveren, um die Eingabe einer benutzerdefinierten URL zu erlauben"

msgctxt "#762"
msgid "Enter a custom update url (url should be the root of the update files)"
msgstr "Benutzerdefinierte URL eingeben (URL sollte das Wurzelverzeichnis der Update-Dateien sein)"

msgctxt "#770"
msgid "Select an available version"
msgstr "Eine verfügbare Version auswählen"

msgctxt "#771"
msgid ""
"The firewall blocks unwanted network traffic. Home (default) allows traffic "
"from private network ranges (192.168.x.x, 172.16.x.x and 10.x.x.x) only. "
"Public blocks all traffic from all networks. Custom uses rules in "
"/storage/.config/iptables. Off disables the firewall."
msgstr "Die Firewall blockiert unerwünschten Netzwerkverkehr. Privat (Standard) erlaubt nur den Datenverkehr von privaten Netzwerkbereichen (192.168.x.x, 172.16.x.x und 10.x.x.x). Öffentlich blockiert den Datenverkehr von allen Netzwerken. Benutzerdefiniert verwendet die Regeln unter /storage/.config/iptables. Deaktiviert schaltet die Firewall aus."

msgctxt "#772"
msgid ""
"Checking for a new version will submit the installed Distribution, Project, "
"CPU Arch and Version to the update server. This data is also used to report "
"basic statistics for the project. To continue checking for updates while "
"opting-out of stats reporting, disable this option."
msgstr "Das Überprüfen auf eine neue Version übermittelt die installierte Distribution, das Projekt, die CPU-Architektur und die Version an den Update-Server. Diese Daten werden auch verwendet, um grundlegende Statistiken für das Projekt zu übermitteln. Um weiterhin nach Updates suchen zu können, bei dem das übermitteln der Statistiken deaktiviert ist, bitte diese Option deaktivieren."

msgctxt "#773"
msgid "Set the idle timeout (in minutes) before devices will be disconnected (defaults to 0 for no timeout). Applies to devices where \"Enable Standby\" has been activated in the @DISTRONAME@ device connection context menu."
msgstr "Das Leerlauf-Timeout (in Minuten) festlegen, bevor Geräte getrennt werden (Standard 0 = kein Timeout). Gilt für Geräte, bei denen \"Standby aktivieren\" im Kontextmenü der @DISTRONAME@-Geräteverbindung aktiviert wurde."

msgctxt "#774"
msgid "Automatic reconnect previously paired device after booting"
msgstr "Zuvor gekoppelte Geräte nach dem Start automatisch wieder verbinden"

msgctxt "#775"
msgid "Automatic change audio output to PULSE when a audio device get connected"
msgstr "Audioausgabe automatisch auf PULSE umstellen, wenn ein Audiogerät verbunden wird"

msgctxt "#776"
msgid "Show notification when a Bluetooth device connects or disconnects (excludes remotes and game controllers)"
msgstr "Benachrichtigung anzeigen, wenn ein Bluetooth-Gerät verbunden oder getrennt wird (außer Fernbedienungen und Game-Controller)"

msgctxt "#777"
msgid "Specify which audio device to restore when Bluetooth disconnects. Leave empty to auto-detect. Example: ALSA: AML-AUGESOUND, HDMI"
msgstr "Festlegen, welches Audiogerät wiederhergestellt wird, wenn Bluetooth getrennt wird. Leer lassen für automatische Erkennung. Beispiel: ALSA: AML-AUGESOUND, HDMI"

msgctxt "#780"
msgid "Configure hardware settings"
msgstr "Hardware-Einstellungen konfigurieren"

msgctxt "#781"
msgid "Set fan mode (off/auto/manual)"
msgstr "Lüftermodus festlegen (Aus/Auto/Manuell)"

msgctxt "#782"
msgid "Set fan speed level"
msgstr "Lüftergeschwindigkeit festlegen"

msgctxt "#785"
msgid "Modify Vendor Bootloader to support all wake-up features such as CEC, Wake-On-LAN, IR, and GPIO wake-up from suspend or power off state!"
msgstr "Hersteller-Bootloader anpassen, um alle Aufweckfunktionen wie CEC, Wake-on-LAN, IR und GPIO-Aufwecken aus dem Standby- oder ausgeschalteten Zustand zu unterstützen!"

msgctxt "#786"
msgid "Set the IR remote control power button code"
msgstr "Code der Einschalttaste der IR-Fernbedienung festlegen"

msgctxt "#787"
msgid "Enable/Disable Wake-on-LAN"
msgstr "Wake-on-LAN aktivieren/deaktivieren"

msgctxt "#788"
msgid "Enable/Disable USB Power when device is off/suspend"
msgstr "USB-Stromversorgung aktivieren/deaktivieren, wenn das Gerät ausgeschaltet oder im Standby ist"

msgctxt "#789"
msgid "Change device LED behavior"
msgstr "LED-Verhalten des Geräts ändern"

msgctxt "#790"
msgid "Enable/Disable VESA display modes"
msgstr "VESA-Anzeigemodi aktivieren/deaktivieren"

msgctxt "#791"
msgid "Set CPU governor for all cores"
msgstr "CPU-Governor für alle Kerne festlegen"

msgctxt "#792"
msgid "Enable/Disable HDD parking on power off/suspend"
msgstr "Parken der Festplatte beim Ausschalten/Standby aktivieren/deaktivieren"

msgctxt "#793"
msgid "Time in seconds to wait for the HDD to spin down when parking"
msgstr "Wartezeit in Sekunden, bis die Festplatte beim Parken zum Stillstand kommt"

msgctxt "#794"
msgid "Time in minutes/hours until the HDD should enter suspend mode"
msgstr "Zeit in Minuten/Stunden, bis die Festplatte in den Ruhezustand wechselt"

msgctxt "#900"
msgid "Configure eMMC speed mode"
msgstr "eMMC-Geschwindigkeitsmodus konfigurieren"

msgctxt "#901"
msgid "Configure WiFi SoC SDIO speed"
msgstr "SDIO-Geschwindigkeit des WLAN-SoC konfigurieren"

msgctxt "#902"
msgid "Enable/Disable SPI interface"
msgstr "SPI-Schnittstelle aktivieren/deaktivieren"

msgctxt "#903"
msgid "Choose IR protocol type for meson-remote"
msgstr "IR-Protokolltyp für meson-remote auswählen"

msgctxt "#904"
msgid "Configure DVB GPIO support"
msgstr "DVB-GPIO-Unterstützung konfigurieren"

msgctxt "#905"
msgid "Configure Wired Network Interface"
msgstr "Kabelgebundene Netzwerkschnittstelle konfigurieren"

msgctxt "#906"
msgid "Choose if IP1001 is assembled"
msgstr "Auswählen, ob ein IP1001 verbaut ist"

msgctxt "#907"
msgid "Switch between using the USB3 interface or the PCIE interface on m.2 connector"
msgstr "Zwischen USB3- und PCIE-Schnittstelle am M.2-Anschluss umschalten"

msgctxt "#908"
msgid "Choose assembled Smartchip device"
msgstr "Verbautes Smartchip-Gerät auswählen"

msgctxt "#909"
msgid "Set to ON to enable service"
msgstr "Auf EIN stellen, um den Dienst zu aktivieren"

msgctxt "#910"
msgid "Set to ON to send invitation to the @DISTRONAME@ developers for remote debugging"
msgstr "Auf EIN stellen, um den @DISTRONAME@-Entwicklern eine Einladung zum Remote-Debugging zu senden"

msgctxt "#911"
msgid "Select the SSH key used for access control"
msgstr "SSH-Schlüssel für die Zugriffskontrolle auswählen"

msgctxt "#912"
msgid "Forum username to identify the connection"
msgstr "Forum-Benutzername zur Identifikation der Verbindung"

