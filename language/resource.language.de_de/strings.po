msgid "Error!"
msgstr "Fehler!"

msgctxt "#33515"
msgid "Inject Bootloader BL301 Blob..."
msgstr "Bootloader-BL301-Blob injizieren..."

msgctxt "#33516"
msgid "[B][COLOR red]Note: This will modify the firmware on your device.[/COLOR][/B][CR]The BL301 bootloader blob has been customized by the CoreELEC Team to support all features used to wake a device from a suspend or power off state!"
msgstr "[B][COLOR red]Hinweis: Dies verändert die Firmware des Geräts.[/COLOR][/B][CR]Der BL301-Bootloader-Blob wurde vom CoreELEC-Team angepasst, um alle Funktionen zu unterstützen, mit denen ein Gerät aus dem Standby- oder ausgeschalteten Zustand aufgeweckt wird!"

msgctxt "#33517"
msgid "Finished update of the BL301 on internal eMMC.[CR]A reboot is now required!"
msgstr "Aktualisierung des BL301 auf dem internen eMMC abgeschlossen.[CR]Ein Neustart ist jetzt erforderlich!"

msgctxt "#33518"
msgid "Error [%d] has occurred while using the 'inject_bl301' tool![CR]See '/storage/inject_bl301.log' for details."
msgstr "Fehler [%d] beim Ausführen des 'inject_bl301'-Tools![CR]Details in '/storage/inject_bl301.log'."

msgctxt "#33519"
msgid "System is not supported by BL301 injection![CR]See '/storage/inject_bl301.log' for details."
msgstr "Das System wird von der BL301-Injektion nicht unterstützt![CR]Details in '/storage/inject_bl301.log'."

msgctxt "#33520"
msgid "Update of BL301 on eMMC is not needed."
msgstr "Eine Aktualisierung des BL301 auf dem eMMC ist nicht erforderlich."

msgctxt "#33521"
msgid "[B][COLOR red]Note: This will remove the bl301 injection on your device.[/COLOR][CR]The injected BL301 bootloader blob will be removed by the backup done automatically before injection.[/B]"
msgstr "[B][COLOR red]Hinweis: Dies entfernt die BL301-Injektion vom Gerät.[/COLOR][CR]Der injizierte BL301-Bootloader-Blob wird anhand des vor der Injektion automatisch erstellten Backups entfernt.[/B]"

msgctxt "#33522"
msgid "Finished remove of the BL301 on internal eMMC.[CR]A reboot is now required!"
msgstr "Entfernen des BL301 vom internen eMMC abgeschlossen.[CR]Ein Neustart ist jetzt erforderlich!"

msgctxt "#33523"
msgid "Finished update of /flash/dtb.img.[CR]A reboot is now required!"
msgstr "Aktualisierung von /flash/dtb.img abgeschlossen.[CR]Ein Neustart ist jetzt erforderlich!"

msgctxt "#33524"
msgid "[COLOR red]Are you sure to change this value?[/COLOR][CR]Please enter confirmation code '%s'"
msgstr "[COLOR red]Diesen Wert wirklich ändern?[/COLOR][CR]Bitte Bestätigungscode '%s' eingeben"

msgctxt "#33525"
msgid "Terminal sharing"
msgstr "Terminal-Freigabe"

msgctxt "#33526"
msgid "Enable terminal sharing"
msgstr "Terminal-Freigabe aktivieren"

msgctxt "#33527"
msgid "Send invitation to @DISTRONAME@ developers"
msgstr "Einladung an die @DISTRONAME@-Entwickler senden"

msgctxt "#33528"
msgid "Hint: enable this option only when requested by team @DISTRONAME@"
msgstr "Hinweis: Diese Option nur aktivieren, wenn das @DISTRONAME@-Team darum bittet"

msgctxt "#33529"
msgid "Access control key"
msgstr "Schlüssel für die Zugriffskontrolle"

msgctxt "#33530"
msgid "Connection name"
msgstr "Verbindungsname"

msgctxt "#33531"
msgid "UAS setting changed.[CR]A reboot is required for the new setting to take effect."
msgstr "UAS-Einstellung geändert.[CR]Ein Neustart ist erforderlich, damit die neue Einstellung wirksam wird."
